# Postgres (snubstack's own DB)
POSTGRES_USER=snubstack
POSTGRES_PASSWORD=change_me
POSTGRES_DB=snubstack
DATABASE_URL=postgresql+asyncpg://snubstack:change_me@postgres:5432/snubstack
DATABASE_URL_SYNC=postgresql://snubstack:change_me@postgres:5432/snubstack

# Jetstream
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
JETSTREAM_COLLECTIONS=app.bsky.feed.post

# Fetch worker
FETCH_USER_AGENT=snubstack/0.1 (+https://snubstack.example/about)
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_BYTES=2000000
FETCH_GLOBAL_RPS=10
FETCH_PER_HOST_CONCURRENCY=1

# Classifier policy
AUTO_PROMOTE_CONFIDENCE=0.9
REVIEW_CONFIDENCE=0.6
RED_REVALIDATE_DAYS=30
GREEN_REVALIDATE_DAYS=180

# Label emission
EMIT_LABELS=false
LABELER_DID=did:plc:replace_me

# Ozone (the labeler/moderation service we call to emit labels)
OZONE_URL=http://ozone:3000
OZONE_ADMIN_PASSWORD=change_me

# Ozone service config (consumed by the ozone container, not snubstack code)
OZONE_PUBLIC_URL=https://labeler.example.com
OZONE_ADMIN_DIDS=did:plc:replace_admin
OZONE_SIGNING_KEY_HEX=replace_me_hex_secp256k1_private_key
OZONE_DB_PASSWORD=change_me_too
